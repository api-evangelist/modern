          "name": "Request access token",
          "request": {
            "name": "Request access token",
            "description": {
              "content": "Exchange the franchise username/password (via HTTP Basic auth) for a bearer access token. Tokens are valid for 24 hours and scoped to a single franchise.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
